---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { PREREQUISITE_RESOURCES, PREREQUISITE_36_WEEKS } from '../data/prerequisites';
---

<BaseLayout
  title="Prerequisites — the 36-week on-ramp"
  description="The optional prerequisite lane of Tensor-to-Tenant: CS50x, Nand to Tetris, MIT 6.042J, Statistical Learning, Git, search, docs, paradigms, and Software Engineering at Google — budgeted over 36 weeks."
  activeNav="resources"
>
  <PageHeader
    eyebrow="Prerequisites"
    title="The on-ramp: 36 weeks if you need it"
    lead="This course starts at Week 1 assuming working programming comfort. If you are coming in without that base, this is the sanctioned prerequisite lane — nine resources, in order, with a 36-week budget. Take it if you need it; skip it if you don't."
    meta="9 resources · 36-week budget · optional lane"
  />

  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="callout">
        <strong>Not a gate — an on-ramp</strong>
        <p>
          Nothing here is a hidden prerequisite. The 108-week curriculum is self-contained. But if you are
          missing fundamentals, this is the sequence and the time budget to close the gap before Week 1 —
          so the arc starts on solid ground instead of shaky ground.
        </p>
      </div>

      <!-- 36-week roadmap -->
      <div class="kicker" style="margin-top:2.5rem">The 36-week budget</div>
      <h2>How the nine resources fit into 36 weeks</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Weeks</th>
              <th>Phase</th>
              <th>Resources</th>
              <th>What you can do after</th>
            </tr>
          </thead>
          <tbody>
            {
              PREREQUISITE_36_WEEKS.map((p) => (
                <tr>
                  <td class="mono num" style="white-space:nowrap">{p.weeks}</td>
                  <td style="min-width:170px"><strong>{p.title}</strong></td>
                  <td style="min-width:220px">{p.resources.join(' · ')}</td>
                  <td style="min-width:280px">{p.outcome}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <!-- Resource cards -->
      <div class="kicker" style="margin-top:2.5rem">The resources</div>
      <h2>Nine links, in the order to take them</h2>
      <div class="grid grid-2" style="margin-top:0.5rem">
        {
          PREREQUISITE_RESOURCES.map((r) => (
            <div class="card" style="padding:1.1rem 1.25rem">
              <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;margin-bottom:0.4rem">
                <span class="chip chip--accent">{r.weeks}</span>
                <span style="font-weight:700;font-size:0.98rem;color:var(--text)">
                  <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
                </span>
              </div>
              <div class="mono" style="font-size:0.78rem;color:var(--accent-2);margin-bottom:0.5rem">{r.focus}</div>
              <p style="font-size:0.9rem;color:var(--text-muted);margin:0">{r.outcome}</p>
            </div>
          ))
        }
      </div>

      <div class="callout callout--violet" style="margin-top:2.5rem">
        <strong>Then Week 1 of the arc</strong>
        <p>
          The 36-week lane is front-loaded exactly where the course front-loads: mathematics first,
          engineering discipline second. When it's done, you enter the tensor-to-tenant arc — see the
          <a href="/curriculum/" style="color:inherit"> curriculum</a> for what Week 1 looks like.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
