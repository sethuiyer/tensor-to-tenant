---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { PHASES, WEEKS, MODE_COUNTS, GPU_WEEKS, RECOVERY_AFTER } from '../data/weeks';
import { PROGRAMS, GATES } from '../data/gates';
import { MANDALAS } from '../data/mandalas';

const arcSteps = [
  { label: 'tensor', desc: 'linear algebra, calculus, probability, information theory — the mathematics under intelligence' },
  { label: 'vector', desc: 'embeddings, retrieval, search and the geometry of meaning' },
  { label: 'model', desc: 'fine-tuning, alignment, agents, RAG and LLM systems' },
  { label: 'serving', desc: 'vLLM, quantization, scheduling, disaggregation and inference at scale' },
  { label: 'platform', desc: 'routing, quotas, idempotency, cost attribution, observability' },
  { label: 'tenant', desc: 'multi-tenant production AI — enterprise-safe, auditable, profitable' },
];

const stats = [
  { value: '108', label: 'instructional weeks' },
  { value: '3', label: 'stackable programs' },
  { value: '10', label: 'phases + milestone gates' },
  { value: '100', label: 'math modules' },
  { value: '30', label: 'engineering tasks' },
  { value: '548', label: 'Darbar problem slots' },
];
---

<BaseLayout title="108-Week AI Engineering & ML Systems Course" activeNav="home">
  <section class="hero">
    <div class="container hero__inner">
      <div class="eyebrow">108-week apprenticeship · 10–15 hrs/week</div>
      <h1>
        From <span class="grad">tensor</span> to <span class="grad">tenant</span> —
        <br />
        become the AI engineer production teams actually need.
      </h1>
      <p class="tagline">{SITE.tagline}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/curriculum/">Explore the curriculum</a>
        <a class="btn" href="#course-structure">How it works</a>
      </div>
      <img
        src="/images/cover_image.webp"
        alt="Tensor-to-Tenant course cover"
        width="960"
        height="640"
        style="max-width:min(760px,100%);height:auto;border-radius:14px;border:1px solid var(--border);box-shadow:0 20px 60px rgba(0,0,0,0.35);margin-top:2.25rem"
      />
    </div>
  </section>

  <!-- Arc -->
  <section class="section section-alt">
    <div class="container">
      <div class="kicker">The arc</div>
      <h2 style="margin-bottom:0.25rem">One progression, six stages</h2>
      <p class="lead" style="max-width:70ch">
        Every phase of the course pushes you one step along the pipeline — from the math inside a
        tensor, all the way to operating a multi-tenant AI platform where real users, real budgets and
        real SLAs live.
      </p>
      <div class="arc">
        {
          arcSteps.map((s, i) => (
            <div class="arc__step">
              <span class="arc__label">0{i + 1} · {s.label}</span>
              <span class="arc__desc">{s.desc}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section">
    <div class="container">
      <div class="grid grid-6" style="grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap:1rem">
        {
          stats.map((s) => (
            <div class="card" style="text-align:center">
              <div style="font-size:2rem;font-weight:800;background:var(--gradient);-webkit-background-clip:text;background-clip:text;color:transparent">
                {s.value}
              </div>
              <div style="font-size:0.85rem;color:var(--text-muted)">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section section-alt" id="why">
    <div class="container">
      <div class="kicker">Why this course exists</div>
      <h2>Most AI tutorials teach you to call an API. This one builds the person who ships the platform.</h2>
      <p class="lead">
        The market is flooded with model wrappers and cookie-cutter bootcamps. This course is the
        opposite: a production-oriented apprenticeship that grounds every abstraction in mathematics,
        then pushes you through the systems that make ML and LLM products actually work in the real
        world — and through the interviews that prove it.
      </p>

      <dl class="grid-dl">
        <div><dt>Production orientation</dt><dd>Every week produces code, a benchmark, a design, or a retrospective — not just notes.</dd></div>
        <div><dt>Evidence-based completion</dt><dd>Progress is proven by artifacts, not attendance. Portfolios at Weeks 30, 69 and 108.</dd></div>
        <div><dt>Mathematics first</dt><dd>100 modules across 10 tracks build the reasoning beneath ML, inference and distributed systems.</dd></div>
        <div><dt>Interview mastery</dt><dd>A continuous 176-item roadmap spanning system design, coding and behavioral preparation.</dd></div>
        <div><dt>Staff-level capstones</dt><dd>Trace forensics with Mo's algorithm, tree forensics with DSU, and an enterprise AI gateway.</dd></div>
        <div><dt>Tenant-aware engineering</dt><dd>From the first primitive you build for concurrency, isolation and fairness — not just a demo.</dd></div>
      </dl>
    </div>
  </section>

  <!-- Structure / 3 programs -->
  <section class="section" id="course-structure">
    <div class="container">
      <div class="kicker">Course structure</div>
      <h2>Three stackable programs</h2>
      <p class="lead">
        Stop at any checkpoint with a publishable release, or continue to the full 108 weeks.
      </p>
      <div class="grid grid-3">
        {
          PROGRAMS.map((p) => (
            <div class="card">
              <div class="card__title"><span class="chip chip--accent">{p.weeks}</span>{p.name}</div>
              <p>{p.release}</p>
              <div class="mono" style="font-size:0.78rem;color:var(--text-faint);margin-top:0.75rem">
                release · Week {p.releaseWeek}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 10 phases -->
  <section class="section section-alt">
    <div class="container">
      <div class="kicker">Phases</div>
      <h2>Ten phases across the 108 weeks</h2>
      <div class="grid grid-2">
        {
          PHASES.map((p) => (
            <div class="card">
              <div class="card__title">
                <span class="chip chip--amber">Phase {p.id}</span>
                <span class="mono" style="font-size:0.78rem;color:var(--text-faint)">Weeks {p.weeks}</span>
              </div>
              <p>{p.theme}</p>
              <div class="mono" style="font-size:0.78rem;color:var(--text-faint);margin-top:0.5rem">
                {WEEKS.filter((w) => w.week >= p.start && w.week <= p.end).length} core deliverables
              </div>
            </div>
          ))
        }
      </div>
      <p style="margin-top:1.5rem">
        <a href="/curriculum/">See the full 108-week table →</a>
      </p>
    </div>
  </section>

  <!-- Parallel tracks -->
  <section class="section">
    <div class="container">
      <div class="kicker">Parallel tracks</div>
      <h2>Three lanes run alongside the weekly spine</h2>
      <div class="grid grid-3">
        <div class="card">
          <div class="card__title"><span class="chip chip--accent">Friday</span>Algorithmic Forge</div>
          <p>
            A weekly algorithmic drill with Core, Supporting, Archive and Boss-fight tiers, mapped across
            all 108 weeks. Friday is for fluency.
          </p>
          <div class="mono" style="margin-top:0.75rem"><a href="/algorithmic-forge/">The Forge →</a></div>
        </div>
        <div class="card">
          <div class="card__title"><span class="chip chip--amber">Canonical</span>System Design Track</div>
          <p>
            Weeks 46–57: foundations, distributed patterns, technology labs, case studies, and OOD/LLD —
            the canonical design lane of the course.
          </p>
          <div class="mono" style="margin-top:0.75rem"><a href="/system-design/">The Design Track →</a></div>
        </div>
        <div class="card">
          <div class="card__title"><span class="chip chip--violet">Parallel</span>Leetcode Darbar</div>
          <p>
            A timed problem-solving lane with a 548-slot tracker and optional Standard/Auror completion
            paths. 3–5 problems per week, timer on.
          </p>
          <div class="mono" style="margin-top:0.75rem"><a href="/leetcode-darbar/">The Darbar →</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GenAI agents track -->
  <section class="section">
    <div class="container">
      <div class="kicker">GenAI agents specialisation</div>
      <h2>From no-code prototypes to autonomous UI agents</h2>
      <p class="lead">
        An 18-module agents track inside the course: LangChain, LangGraph, AutoGen, CrewAI, Model Context
        Protocol, agentic design patterns, DSPy, Kùzu graph RAG — capped by Project Manus, an agent that
        autonomously operates a real browser and terminal.
      </p>
      <div class="card" style="padding:1.25rem 1.5rem">
        <div class="card__title"><span class="chip chip--violet">18 modules</span>GenAI Agents track</div>
        <p style="color:var(--text-muted)">
          Foundations → prompting → RAG → agents from scratch → MCP → three orchestration frameworks →
          agentic patterns → advanced RAG → DSPy → Kùzu. Every framework grounded in evidence-first,
          tenant-aware engineering.
        </p>
        <div class="mono" style="margin-top:0.75rem"><a href="/agents/">Explore the modules →</a></div>
      </div>
    </div>
  </section>

  <!-- Mandala identity -->
  <section class="section section-alt">
    <div class="container">
      <div class="kicker">The mandala progression</div>
      <h2>You don't take notes — you become someone else</h2>
      <p class="lead">
        Sixteen mandalas turn the course into an identity ladder: each 48-day cycle ends with a
        capability you can prove.
      </p>
      <div style="text-align:center">
        <img
          src="/images/mandala.webp"
          alt="The sixteen mandalas of the identity ladder"
          width="440"
          height="440"
          loading="lazy"
          style="max-width:min(440px,100%);height:auto;border-radius:50%;border:1px solid var(--border);box-shadow:0 20px 60px rgba(0,0,0,0.35)"
        />
      </div>
      <div class="timeline">
        {
          MANDALAS.map((m) => (
            <div class="timeline__item">
              <div class="timeline__num">Mandala {m.id === 'final' ? '16 · graduation' : m.id} · {m.weeks}</div>
              <h3>{m.title}</h3>
              <p><strong style="color:var(--accent-2)">{m.identity}</strong></p>
              <p>{m.transformation}</p>
            </div>
          ))
        }
      </div>
      <p><a href="/mandala/">Full mandala breakdown →</a></p>
    </div>
  </section>

  <!-- Gates -->
  <section class="section">
    <div class="container">
      <div class="kicker">Milestone gates</div>
      <h2>Progress is gated, not assumed</h2>
      <p class="lead">
        Ten blocking checkpoints. A failed gate pauses new content until its remediation plan is
        complete and the missing evidence is submitted.
      </p>
      <div class="grid grid-2">
        {
          GATES.map((g) => (
            <div class="card">
              <div class="card__title"><span class="chip chip--accent">Gate {g.gate}</span><span class="mono" style="font-size:0.78rem;color:var(--text-faint)">Week {g.week}</span></div>
              <p>{g.criteria}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Capstones -->
  <section class="section section-alt">
    <div class="container">
      <div class="kicker">Capstones</div>
      <h2>Three staff-level finale paths</h2>
      <div class="grid grid-3">
        <div class="card">
          <div class="card__title"><span class="chip chip--ok">Required</span>Capstone 1</div>
          <p>Multi-Tenant LLM Trace Forensics with Mo's algorithm — exact batch queries over immutable trace segments.</p>
        </div>
        <div class="card">
          <div class="card__title"><span class="chip chip--amber">Boss fight</span>Capstone 2</div>
          <p>Agent Execution Forensics with Euler Tour + DSU on Tree — subtree analytics over 50k-node agent trees.</p>
        </div>
        <div class="card">
          <div class="card__title"><span class="chip chip--violet">Gateway</span>Capstone 3</div>
          <p>An OpenRouter-inspired enterprise multi-model AI gateway: routing, tenancy, accounting and reliability.</p>
        </div>
      </div>
      <p style="margin-top:1.25rem"><a href="/capstones/">Capstone specifications →</a></p>
    </div>
  </section>

  <!-- Get started / cookiecutter -->
  <section class="section">
    <div class="container">
      <div class="card" style="padding:2rem">
        <h2>Ready to run the arc?</h2>
        <p class="lead">
          The fastest way to start is the course's cookiecutter: one command scaffolds a complete learner
          repository — all 108 weekly journals stamped with your start date, the phase folders, engineering
          primitives, the Darbar tracker, milestone gates, portfolio checklists, and helper scripts.
        </p>
        <code
          style="display:block;width:fit-content;max-width:100%;background:var(--surface-2);border:1px solid var(--border);padding:0.7rem 1rem;border-radius:8px;font-family:var(--font-mono);color:var(--accent);margin:1rem 0 1.5rem"
        >cookiecutter gh:sethuiyer/tensor-to-tenant</code>
        <div class="btn-row" style="margin-bottom:0">
          <a class="btn btn--primary" href="/curriculum/">Start with the curriculum</a>
          <a class="btn" href="/prerequisites/">The 36-week on-ramp</a>
          <a class="btn" href="/agents/">The agents track</a>
          <a class="btn" href="/faq/">FAQ</a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
