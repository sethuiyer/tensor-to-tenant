---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../config';
---

<BaseLayout
  title="Search"
  description="Search across every page of the Tensor-to-Tenant course — curriculum, mathematics, engineering, agents, mandalas, the forge, and more."
  activeNav="search"
>
  <PageHeader
    eyebrow="Search"
    title="Search the course"
    lead="Every page is indexed at build time — curriculum, mathematics, engineering, system design, agents, mandalas, the forge, the Darbar, and the capstones."
    meta="static index · no data leaves your browser"
  />

  <section class="section" style="padding-top:1rem">
    <div class="container" style="max-width:760px">
      <div id="search"></div>
      <noscript>
        <p style="color:var(--text-muted)">
          Search requires JavaScript. Browse the <a href={url('/curriculum/')}>curriculum</a> directly instead.
        </p>
      </noscript>
    </div>
  </section>
</BaseLayout>

<link rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} />
<script src={url('/pagefind/pagefind-ui.js')} defer></script>
<script>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) return;
    const base = import.meta.env.BASE_URL;
    new window.PagefindUI({
      element: '#search',
      baseUrl: base,
      bundlePath: `${base}pagefind/`,
      showSubResults: true,
    });
  });
</script>

<style is:global>
  /* Make the Pagefind UI follow the site theme. Scoped under #search so it
     wins over the defaults in pagefind-ui.css (which load after this). */
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg-elevated);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__search-input::placeholder {
    color: var(--text-faint);
  }
  #search .pagefind-ui__result-link {
    color: var(--accent);
  }
  #search .pagefind-ui__result-excerpt mark,
  #search .pagefind-ui__result mark {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 2px;
  }
  #search .pagefind-ui__button {
    background: var(--surface-2);
    border-color: var(--border);
    color: var(--text);
  }
  #search .pagefind-ui__button:hover {
    border-color: var(--border-strong);
  }
</style>
